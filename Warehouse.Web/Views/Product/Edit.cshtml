@model Warehouse.Web.Models.UpdateProductViewModel

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header">
            <h3>Sửa sản phẩm</h3>
        </div>

        <div class="card-body">

            <form asp-action="Edit"
                  method="post">

                <input asp-for="ProductId"
                       hidden />

                <div class="mb-3">
                    <label>SKU</label>

                    <input asp-for="SKU"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Tên sản phẩm</label>

                    <input asp-for="ProductName"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Số lượng</label>

                    <input asp-for="Quantity"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Giá</label>

                    <input asp-for="Price"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Min Stock</label>

                    <input asp-for="MinStock"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Supplier Id</label>

                    <input asp-for="SupplierId"
                           class="form-control" />
                </div>

                <button class="btn btn-warning">
                    Cập nhật
                </button>

            </form>

        </div>

    </div>

</div>