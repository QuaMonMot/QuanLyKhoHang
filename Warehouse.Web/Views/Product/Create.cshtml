@model Warehouse.Web.Models.CreateProductViewModel

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header">
            <h3>Thêm sản phẩm</h3>
        </div>

        <div class="card-body">

            <form asp-action="Create"
                  method="post">

                <div class="mb-3">
                    <label>SKU</label>

                    <input asp-for="SKU"
                           class="form-control" />

                    <span asp-validation-for="SKU"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label>Tên sản phẩm</label>

                    <input asp-for="ProductName"
                           class="form-control" />

                    <span asp-validation-for="ProductName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label>Số lượng</label>

                    <input asp-for="Quantity"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Giá</label>

                    <input asp-for="Price"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Tồn kho tối thiểu</label>

                    <input asp-for="MinStock"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Supplier Id</label>

                    <input asp-for="SupplierId"
                           class="form-control" />
                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Thêm sản phẩm
                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}