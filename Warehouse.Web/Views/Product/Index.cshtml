@model IEnumerable<Warehouse.Web.Models.ProductViewModel>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPage = ViewBag.TotalPage ?? 1;
}

<div class="page-title">
    <span><i class="fa-solid fa-box me-2 text-primary"></i> Quản lý sản phẩm</span>
    @if (Context.Session.GetInt32("ROLE") == 1)
    {
        <a asp-controller="Product" asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i> Thêm sản phẩm
        </a>
    }
</div>

<!-- Search Bar -->
<div class="card mb-4">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="d-flex align-items-center">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">
                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                </span>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0 ps-0" placeholder="Tìm kiếm sản phẩm theo tên, SKU..." />
                <button class="btn btn-primary px-4" type="submit">Tìm kiếm</button>
            </div>
        </form>
    </div>
</div>

<!-- Product Grid -->
<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h5 class="card-title text-primary font-weight-bold mb-0">@item.ProductName</h5>
                        <span class="badge bg-light text-dark border">@item.SKU</span>
                    </div>
                    
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted"><i class="fa-solid fa-tag me-1"></i> Giá:</span>
                            <strong class="text-success">$@item.Price</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted"><i class="fa-solid fa-layer-group me-1"></i> Số lượng:</span>
                            <strong class="@(item.Quantity < 10 ? "text-danger" : "text-main")">@item.Quantity</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted"><i class="fa-solid fa-truck-field me-1"></i> NCC:</span>
                            <span class="text-truncate" style="max-width: 150px;" title="@item.SupplierName">@item.SupplierName</span>
                        </div>
                    </div>
                </div>
                
                @if (Context.Session.GetInt32("ROLE") == 1)
                {
                    <div class="card-footer bg-transparent border-top-0 pt-0 pb-3">
                        <div class="d-flex gap-2">
                            <a asp-controller="Product" asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-primary flex-fill">
                                <i class="fa-solid fa-pen-to-square me-1"></i> Sửa
                            </a>
                            <a asp-controller="Product" asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-danger flex-fill">
                                <i class="fa-solid fa-trash me-1"></i> Xóa
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Pagination -->
@if (totalPage > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">
                    <i class="fa-solid fa-chevron-left"></i> Trước
                </a>
            </li>
            
            @for (int i = 1; i <= totalPage; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }

            <li class="page-item @(currentPage == totalPage ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">
                    Sau <i class="fa-solid fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}