<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Warehouse.Web</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Warehouse.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div id="wrapper">
        <!-- Sidebar -->
        <aside id="sidebar-wrapper">
            <div class="sidebar-heading">
                <i class="fa-solid fa-boxes-stacked text-primary"></i> Warehouse
            </div>
            <div class="list-group list-group-flush mt-3">
                <a asp-controller="Dashboard" asp-action="Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="fa-solid fa-chart-pie"></i> Tổng quan
                </a>
                <a asp-controller="Product" asp-action="Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" ? "active" : "")">
                    <i class="fa-solid fa-box"></i> Sản phẩm
                </a>
                <a asp-controller="Supplier" asp-action="Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Supplier" ? "active" : "")">
                    <i class="fa-solid fa-truck-field"></i> Nhà cung cấp
                </a>
                <a asp-controller="Stock" asp-action="Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Stock" ? "active" : "")">
                    <i class="fa-solid fa-warehouse"></i> Quản lý kho
                </a>
                <a asp-controller="Report" asp-action="Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Report" ? "active" : "")">
                    <i class="fa-solid fa-chart-line"></i> Báo cáo
                </a>
            </div>
        </aside>

        <!-- Page Content -->
        <div id="page-content-wrapper">
            <!-- Top Navbar -->
            <nav class="top-navbar">
                <button class="toggle-btn" id="menu-toggle">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <div class="d-flex align-items-center gap-3">
                    <div class="dropdown">
                        @{
                            var username = Context.Session.GetString("USERNAME");
                            var displayName = string.IsNullOrEmpty(username) ? "Tài khoản" : username;
                        }
                        <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle" id="dropdownUser" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="https://ui-avatars.com/api/?name=@(displayName)&background=4361ee&color=fff" alt="User" width="32" height="32" class="rounded-circle me-2">
                            <strong>@displayName</strong>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="dropdownUser">
                            @if (string.IsNullOrEmpty(username))
                            {
                                <li><a class="dropdown-item" asp-controller="Auth" asp-action="Login"><i class="fa-solid fa-right-to-bracket me-2"></i> Đăng nhập</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" asp-controller="Auth" asp-action="Profile"><i class="fa-solid fa-user me-2"></i> Hồ sơ</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout"><i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Main Content Area -->
            <main class="main-content">
                @RenderBody()
            </main>
            
            <footer class="footer bg-white text-muted text-center py-3 border-top mt-auto flex-shrink-0" style="position: relative; z-index: 10;">
                <div class="container-fluid">
                    &copy; 2026 - Warehouse.Web - Thiết kế hiện đại
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Sidebar Toggle Script
        $("#menu-toggle").click(function(e) {
            e.preventDefault();
            $("#wrapper").toggleClass("toggled");
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
