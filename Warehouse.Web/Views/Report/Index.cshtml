@model IEnumerable<Warehouse.Web.Models.StockReportViewModel>

@{
    ViewData["Title"] = "Báo cáo kho";
}

<div class="page-title">
    <span><i class="fa-solid fa-chart-line me-2 text-primary"></i> Báo cáo nhập xuất kho</span>
</div>

<div class="report-panel">
    <div class="table-responsive table-wrapper">
        <table class="table table-dark table-bordered table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Tên sản phẩm</th>
                    <th>Nhà cung cấp</th>
                    <th class="text-center">Tổng nhập</th>
                    <th class="text-center">Tổng xuất</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td><span class="text-muted small">@item.SupplierName</span></td>
                        <td class="text-center">
                            <span class="badge bg-success rounded-pill px-3 py-2">@item.TotalImport</span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-danger rounded-pill px-3 py-2">@item.TotalExport</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
