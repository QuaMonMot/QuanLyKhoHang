@model Warehouse.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Tổng quan";
}

<div class="page-title">
    <span><i class="fa-solid fa-gauge-high me-2 text-primary"></i> Tổng quan kho</span>
    <a class="btn btn-primary" asp-controller="Report" asp-action="Index">
        <i class="fa-solid fa-file-lines me-2"></i>Báo cáo
    </a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-warning" role="alert">
        @ViewBag.Error
    </div>
}

<section class="dashboard-hero">
    <div>
        <p class="dashboard-eyebrow">Warehouse API Dashboard</p>
        <h2>Thông tin tồn kho hiện tại</h2>
    </div>
    <div class="dashboard-total">
        <span>Tổng tồn kho</span>
        <strong>@Model.TotalStock.ToString("N0")</strong>
    </div>
</section>

<div class="row g-4 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="metric-card">
            <div class="metric-icon">
                <i class="fa-solid fa-boxes-stacked"></i>
            </div>
            <div>
                <span>Sản phẩm</span>
                <strong>@Model.TotalProducts.ToString("N0")</strong>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="metric-card">
            <div class="metric-icon">
                <i class="fa-solid fa-warehouse"></i>
            </div>
            <div>
                <span>Tổng tồn</span>
                <strong>@Model.TotalStock.ToString("N0")</strong>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="metric-card success">
            <div class="metric-icon">
                <i class="fa-solid fa-circle-arrow-down"></i>
            </div>
            <div>
                <span>Tổng nhập</span>
                <strong>@Model.TotalImport.ToString("N0")</strong>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="metric-card danger">
            <div class="metric-icon">
                <i class="fa-solid fa-circle-arrow-up"></i>
            </div>
            <div>
                <span>Tổng xuất</span>
                <strong>@Model.TotalExport.ToString("N0")</strong>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="metric-card warning h-100">
            <div class="metric-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div>
                <span>Sản phẩm tồn thấp</span>
                <strong>@Model.LowStockProducts.ToString("N0")</strong>
                <p class="mb-0 text-muted small">Cần nhập thêm hàng ngay</p>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="section-panel h-100">
            <h5 class="mb-3 d-flex align-items-center">
                <i class="fa-solid fa-chart-simple me-2 text-primary"></i> 
                Thống kê sản phẩm nổi bật
            </h5>
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Tên sản phẩm</th>
                            <th class="text-center">Tổng nhập</th>
                            <th class="text-center">Tổng xuất</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ProductStats != null && Model.ProductStats.Any())
                        {
                            foreach (var item in Model.ProductStats)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td class="text-center">
                                        <span class="text-success">+@item.TotalImport.ToString("N0")</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-danger">-@item.TotalExport.ToString("N0")</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">Chưa có dữ liệu thống kê.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
