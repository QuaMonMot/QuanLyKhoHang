@model Warehouse.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Tổng quan";
}

<div class="page-title">
    <span><i class="fa-solid fa-gauge-high me-2 text-primary"></i> Tổng quan kho</span>
    <a class="btn btn-primary" asp-controller="Report" asp-action="Index">
        <i class="fa-solid fa-file-lines me-2"></i>Báo cáo
    </a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-warning" role="alert">
        @ViewBag.Error
    </div>
}

<section class="dashboard-hero">
    <div>
        <p class="dashboard-eyebrow">Warehouse API Dashboard</p>
        <h2>Thông tin tồn kho hiện tại</h2>
        <p class="dashboard-copy">
            Dữ liệu được lấy từ endpoint <strong>/api/Stock/dashboard</strong>, hiển thị trực tiếp bằng các chỉ số tổng quan thay cho biểu đồ.
        </p>
    </div>
    <div class="dashboard-total">
        <span>Tổng tồn kho</span>
        <strong>@Model.TotalStock.ToString("N0")</strong>
    </div>
</section>

<div class="row g-4">
    <div class="col-lg-4 col-md-6">
        <div class="metric-card">
            <div class="metric-icon">
                <i class="fa-solid fa-boxes-stacked"></i>
            </div>
            <div>
                <span>Sản phẩm</span>
                <strong>@Model.TotalProducts.ToString("N0")</strong>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-6">
        <div class="metric-card">
            <div class="metric-icon">
                <i class="fa-solid fa-warehouse"></i>
            </div>
            <div>
                <span>Tổng tồn</span>
                <strong>@Model.TotalStock.ToString("N0")</strong>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-6">
        <div class="metric-card warning">
            <div class="metric-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div>
                <span>Tồn thấp</span>
                <strong>@Model.LowStockProducts.ToString("N0")</strong>
            </div>
        </div>
    </div>
</div>
