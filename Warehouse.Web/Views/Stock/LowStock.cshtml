@model List<Warehouse.Web.Models.ProductViewModel>

@{
    ViewData["Title"] = "Tồn kho thấp";
}

<div class="page-title">
    <span><i class="fa-solid fa-triangle-exclamation me-2 text-primary"></i> Sản phẩm tồn kho thấp</span>
    <a asp-controller="Stock" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
    </a>
</div>

<div class="section-panel">
    <div class="table-responsive table-wrapper">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-danger">
                <tr>
                    <th>ID</th>
                    <th>SKU</th>
                    <th>Tên sản phẩm</th>
                    <th class="text-center">Tồn kho</th>
                    <th class="text-center">Tồn tối thiểu</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ProductId</td>
                        <td><span class="badge bg-light text-dark border">@item.SKU</span></td>
                        <td>@item.ProductName</td>
                        <td class="text-center">
                            <span class="badge bg-danger rounded-pill px-3 py-2">@item.Quantity</span>
                        </td>
                        <td class="text-center">@item.MinStock</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
