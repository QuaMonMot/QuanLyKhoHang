@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container-fluid d-flex flex-column justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="text-center">
        <i class="fa-solid fa-boxes-packing text-primary" style="font-size: 5rem; margin-bottom: 2rem; opacity: 0.8;"></i>
        <h1 class="display-4 fw-bold text-main mb-3">Chào mừng đến với <span class="text-primary">Warehouse.Web</span></h1>
        <p class="lead text-muted mb-4">Hệ thống quản lý kho hàng </p>
        
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg px-4 rounded-pill shadow-sm">
                <i class="fa-solid fa-chart-pie me-2"></i> Xem Tổng Quan
            </a>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 rounded-pill shadow-sm bg-white">
                <i class="fa-solid fa-box me-2"></i> Quản lý Sản Phẩm
            </a>
        </div>
    </div>
</div>
