@model IEnumerable<Warehouse.Web.Models.SupplierViewModel>

@{
    ViewData["Title"] = "Nhà cung cấp";
}

<div class="page-title">
    <span><i class="fa-solid fa-truck-field me-2 text-primary"></i> Quản lý Nhà cung cấp</span>
    @if (Context.Session.GetInt32("ROLE") == 1)
    {
        <a asp-controller="Supplier" asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i> Thêm mới
        </a>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive table-wrapper">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th width="5%">#</th>
                        <th width="15%">Mã NCC</th>
                        <th width="25%">Tên Nhà Cung Cấp</th>
                        <th width="15%">Số Điện Thoại</th>
                        <th width="30%">Địa Chỉ</th>
                        <th width="10%" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><span class="text-muted">@item.SupplierId</span></td>
                            <td><span class="badge bg-secondary">@item.SupplierCode</span></td>
                            <td class="font-weight-bold text-main">@item.SupplierName</td>
                            <td><i class="fa-solid fa-phone fa-sm text-muted me-1"></i> @item.Phone</td>
                            <td><i class="fa-solid fa-location-dot fa-sm text-muted me-1"></i> @item.Address</td>
                            <td class="text-center">
                                @if (Context.Session.GetInt32("ROLE") == 1)
                                {
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.SupplierId" class="btn btn-outline-primary" title="Sửa">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.SupplierId" class="btn btn-outline-danger" title="Xóa">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted"><i class="fa-solid fa-ban"></i></span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>